{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machinome.org/schema/machinome-movie-0.2.json",
  "title": "machinome-movie/0.2",
  "description": "The unresolved movie document: field names, types, required fields and closed field lists. Values (a set kind, an easing, a range, a phrase, the format string) are checked by the runtimes, which name what they refuse. See docs/movie-document.md.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "learningGoal": {
      "type": "string"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "string"
        },
        "expectedDurationSeconds": {
          "type": "number"
        },
        "timeMode": {
          "type": "string"
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "type": "string"
        }
      },
      "required": [
        "manifest",
        "expectedDurationSeconds",
        "timeMode",
        "sourceRevision"
      ],
      "additionalProperties": false
    },
    "marks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "voiceLabel": {
          "type": "string"
        },
        "outputFormat": {
          "type": "string"
        },
        "voiceSettings": {
          "type": "object"
        },
        "replacements": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "direction": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "voice"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string"
        },
        "foreground": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        },
        "safeInsetFraction": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "cameras": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "target": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "up": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "fov": {
            "type": "number"
          }
        },
        "required": [
          "position",
          "target",
          "up",
          "fov"
        ],
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sourceCode": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "file",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "stills": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/media"
      }
    },
    "clips": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/media"
      }
    },
    "credits": {
      "type": "object"
    },
    "release": {
      "type": "object",
      "properties": {
        "simulationUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptionTemplate": {
          "type": "string"
        },
        "publish": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "$ref": "#/$defs/stage"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    }
  },
  "required": [
    "format",
    "id",
    "title",
    "root",
    "output",
    "model",
    "audio",
    "cameras",
    "layers",
    "evidence",
    "stage",
    "chapters"
  ],
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "seconds": {
      "title": "seconds",
      "type": "number"
    },
    "spoken": {
      "title": "spoken anchor",
      "type": "object",
      "properties": {
        "spoken": {
          "type": "string",
          "minLength": 1
        },
        "plus": {
          "type": "number"
        }
      },
      "required": [
        "spoken"
      ],
      "additionalProperties": false
    },
    "spokenEnd": {
      "title": "spokenEnd anchor",
      "type": "object",
      "properties": {
        "spokenEnd": {
          "type": "string",
          "minLength": 1
        },
        "plus": {
          "type": "number"
        }
      },
      "required": [
        "spokenEnd"
      ],
      "additionalProperties": false
    },
    "time": {
      "title": "time",
      "description": "Shot-local seconds, or a spoken anchor.",
      "oneOf": [
        {
          "$ref": "#/$defs/seconds"
        },
        {
          "$ref": "#/$defs/spoken"
        },
        {
          "$ref": "#/$defs/spokenEnd"
        }
      ]
    },
    "markAnchor": {
      "title": "mark",
      "type": "object",
      "properties": {
        "mark": {
          "type": "string",
          "minLength": 1
        },
        "plus": {
          "type": "number"
        }
      },
      "required": [
        "mark"
      ],
      "additionalProperties": false
    },
    "modelSeconds": {
      "title": "model seconds",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/markAnchor"
        }
      ]
    },
    "media": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "credit": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights": {
          "type": [
            "string",
            "null"
          ]
        },
        "upscale": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "part": {
      "title": "part",
      "description": "A layer name or an assembly path.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ]
    },
    "entrance": {
      "title": "entrance",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "ease": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "duration"
      ],
      "additionalProperties": false
    },
    "action": {
      "title": "action",
      "description": "An action of a shipped element kind, or a project action with its params; which fields an action takes is decided by its name, and the runtimes refuse a field the action does not take.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "camera": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "until": {
              "$ref": "#/$defs/time"
            },
            "ease": {
              "type": "string"
            }
          },
          "required": [
            "element",
            "action",
            "camera",
            "until"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/part"
              },
              "minItems": 1
            },
            "others": {
              "type": "string"
            },
            "color": {
              "type": "string"
            }
          },
          "required": [
            "element",
            "action",
            "parts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "part": {
              "$ref": "#/$defs/part"
            },
            "padding": {
              "type": "number"
            },
            "enter": {
              "$ref": "#/$defs/entrance"
            },
            "leave": {
              "$ref": "#/$defs/entrance"
            }
          },
          "required": [
            "element",
            "action",
            "part"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "part": {
              "$ref": "#/$defs/part"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "offset": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "enter": {
              "$ref": "#/$defs/entrance"
            },
            "leave": {
              "$ref": "#/$defs/entrance"
            }
          },
          "required": [
            "element",
            "action",
            "part",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "part": {
              "$ref": "#/$defs/part"
            },
            "point": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "place": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "enter": {
              "$ref": "#/$defs/entrance"
            },
            "leave": {
              "$ref": "#/$defs/entrance"
            }
          },
          "required": [
            "element",
            "action",
            "place"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "throughLine": {
              "type": "integer",
              "minimum": 1
            },
            "over": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "element",
            "action",
            "throughLine",
            "over"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "words": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "spoken": {
                    "type": "string",
                    "minLength": 1
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "spoken",
                  "token"
                ],
                "additionalProperties": false
              }
            },
            "hold": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "element",
            "action",
            "words"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "enter": {
              "$ref": "#/$defs/entrance"
            },
            "leave": {
              "$ref": "#/$defs/entrance"
            },
            "reveal": {
              "type": "object",
              "properties": {
                "timing": {
                  "type": "string"
                },
                "phrase": {
                  "type": "string",
                  "minLength": 1
                },
                "duration": {
                  "type": "number"
                },
                "ease": {
                  "type": "string"
                }
              },
              "required": [
                "timing"
              ],
              "additionalProperties": false
            },
            "view": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "$ref": "#/$defs/time"
                  },
                  "center": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "zoom": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "ease": {
                    "type": "string"
                  }
                },
                "required": [
                  "at",
                  "center",
                  "zoom"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "element",
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "action": {
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          },
          "required": [
            "element",
            "action",
            "params"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cue": {
      "title": "cue",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/time"
        },
        "until": {
          "$ref": "#/$defs/time"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "required": [
        "at",
        "actions"
      ],
      "additionalProperties": false
    },
    "element": {
      "title": "element",
      "description": "A chapter's element: a shipped kind with its declaration, or a project kind with its props.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "camera": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "hide": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "still": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "clip": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "fit": {
          "type": "string"
        },
        "inPoint": {
          "type": "number"
        },
        "props": {
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "model": {
      "title": "model time",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/modelSeconds"
            },
            "to": {
              "$ref": "#/$defs/modelSeconds"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "$ref": "#/$defs/time"
                  },
                  "seconds": {
                    "$ref": "#/$defs/modelSeconds"
                  },
                  "ease": {
                    "type": "string"
                  }
                },
                "required": [
                  "at",
                  "seconds"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "keys"
          ],
          "additionalProperties": false
        }
      ]
    },
    "join": {
      "title": "join",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ease": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      },
      "required": [
        "duration"
      ],
      "additionalProperties": false
    },
    "shot": {
      "title": "shot",
