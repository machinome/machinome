        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "set": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "places": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "until": {
          "$ref": "#/$defs/time"
        },
        "direction": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "transition": {
          "$ref": "#/$defs/join"
        },
        "fadeIn": {
          "$ref": "#/$defs/join"
        },
        "fadeOut": {
          "$ref": "#/$defs/join"
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          }
        }
      },
      "required": [
        "id",
        "set",
        "places",
        "until",
        "model",
        "cues"
      ],
      "additionalProperties": false
    },
    "chapter": {
      "title": "chapter",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "speechOffset": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "type": "string"
        },
        "elements": {
          "type": "object",
