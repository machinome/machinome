{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "machinome-movie/0.1",
  "description": "The unresolved movie document: what a movie's declarations evaluate to and the renderer loads. See docs/movie-document.md.",
  "type": "object",
  "properties": {
    "format": {
      "const": "machinome-movie/0.1"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "learningGoal": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "expectedDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeMode": {
          "const": "normalized-loop"
        },
        "sourceRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "readiness": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "manifest",
        "expectedDurationSeconds",
        "timeMode",
        "sourceRevision",
        "readiness"
      ]
    },
    "marks": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "voiceLabel": {
          "type": "string",
          "minLength": 1
        },
        "outputFormat": {
          "type": "string",
          "minLength": 1
        },
        "voiceSettings": {
          "type": "object"
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "replacements": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "voice"
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "foreground": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "safeInsetFraction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.5
        }
      },
      "additionalProperties": false
    },
    "cameras": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/camera"
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "minItems": 1
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceCode": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "additionalProperties": false,
        "required": [
          "file",
          "lines"
        ]
      }
    },
    "stills": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/picture"
      }
    },
    "clips": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/picture"
      }
    },
    "credits": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "copyright": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseFile": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "simulationUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptionTemplate": {
          "type": "string",
          "minLength": 1
        },
        "publish": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "simulationUrl",
        "sourceUrl",
        "descriptionTemplate"
      ]
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "title",
    "status",
    "learningGoal",
    "root",
    "output",
    "model",
    "marks",
    "audio",
    "cameras",
    "layers",
    "evidence",
    "sourceCode",
    "stills",
    "clips",
    "chapters"
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "ease": {
      "enum": [
        "linear",
        "smooth",
        "in",
        "out",
        "in-out"
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "spoken": {
      "type": "object",
      "properties": {
        "spoken": {
          "type": "string",
          "minLength": 1
        },
        "plus": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "spoken"
      ]
    },
    "spokenEnd": {
      "type": "object",
      "properties": {
        "spokenEnd": {
          "type": "string",
          "minLength": 1
        },
        "plus": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "spokenEnd"
      ]
    },
    "mark": {
      "type": "object",
      "properties": {
        "mark": {
          "type": "string",
          "minLength": 1
        },
        "plus": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "mark"
      ]
    },
    "videoTime": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/spoken"
        },
        {
          "$ref": "#/$defs/spokenEnd"
        }
      ]
    },
    "modelTime": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/mark"
        }
      ]
    },
    "entrance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "fade",
            "draw"
          ]
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ease": {
          "$ref": "#/$defs/ease"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "duration"
      ]
    },
    "exit": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "fade"
          ]
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ease": {
          "$ref": "#/$defs/ease"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "duration"
      ]
    },
    "part": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "up": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fov": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "up",
        "fov"
      ]
    },
    "picture": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "credit": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights": {
          "type": [
            "string",
            "null"
          ]
        },
        "upscale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "credit",
        "rights"
      ]
    },
    "simulation": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/modelTime"
        },
        "to": {
          "$ref": "#/$defs/modelTime"
        },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "$ref": "#/$defs/videoTime"
              },
              "seconds": {
                "$ref": "#/$defs/modelTime"
              },
              "ease": {
                "$ref": "#/$defs/ease"
              }
            },
            "additionalProperties": false,
            "required": [
              "at",
              "seconds"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    },
    "cameraKey": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/videoTime"
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "ease": {
          "$ref": "#/$defs/ease"
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "preset"
      ]
    },
    "overlay": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/videoTime"
        },
        "to": {
          "$ref": "#/$defs/videoTime"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "enum": [
            "title",
            "top",
            "lower-third",
            "center"
          ]
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "enter": {
          "$ref": "#/$defs/exit"
        },
        "leave": {
          "$ref": "#/$defs/exit"
        },
        "reveal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "timing": {
                  "const": "spoken"
                },
                "phrase": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "timing"
              ]
            },
            {
              "type": "object",
              "properties": {
                "timing": {
                  "const": "even"
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "ease": {
                  "$ref": "#/$defs/ease"
                }
              },
              "additionalProperties": false,
              "required": [
                "timing",
                "duration"
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "text"
      ]
    },
    "annotation": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/videoTime"
        },
        "to": {
          "$ref": "#/$defs/videoTime"
        },
        "kind": {
          "enum": [
            "arrow",
            "label",
            "ring"
          ]
        },
        "part": {
          "$ref": "#/$defs/part"
        },
        "point": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "place": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "enter": {
          "$ref": "#/$defs/entrance"
        },
        "leave": {
          "$ref": "#/$defs/exit"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ]
    },
    "highlight": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/videoTime"
        },
        "to": {
          "$ref": "#/$defs/videoTime"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          },
          "minItems": 1
        },
        "others": {
          "enum": [
            "keep",
            "dim",
            "ghost"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "parts"
      ]
    },
    "code": {
      "type": "object",
      "properties": {
        "snippet": {
          "type": "string",
          "minLength": 1
        },
        "typing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "$ref": "#/$defs/videoTime"
              },
              "to": {
                "$ref": "#/$defs/videoTime"
              },
              "throughLine": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "throughLine"
            ]
          }
        },
        "emphasis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "phrase": {
                "type": "string",
                "minLength": 1
              },
              "words": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "hold": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "line",
              "phrase",
              "words"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "snippet",
        "typing"
      ]
    },
    "pictureCue": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/videoTime"
        },
        "to": {
          "$ref": "#/$defs/videoTime"
        },
        "still": {
          "type": "string",
          "minLength": 1
        },
        "clip": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "enum": [
            "stage",
            "frame"
          ]
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "enter": {
          "$ref": "#/$defs/exit"
        },
        "leave": {
          "$ref": "#/$defs/exit"
        },
        "inPoint": {
          "type": "number",
          "minimum": 0
        },
        "view": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "$ref": "#/$defs/videoTime"
              },
              "center": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "zoom": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ease": {
                "$ref": "#/$defs/ease"
              }
            },
            "additionalProperties": false,
            "required": [
              "at",
              "center",
              "zoom"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    },
    "transition": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "fade",
            "dissolve",
            "wipe",
            "slide"
          ]
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ease": {
          "$ref": "#/$defs/ease"
        },
        "direction": {
          "enum": [
            "left",
            "right"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "duration"
      ]
    },
    "fade": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ease": {
          "$ref": "#/$defs/ease"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      },
      "additionalProperties": false,
      "required": [
        "duration"
      ]
    },
    "shot": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "set": {
          "enum": [
            "paper",
            "paper-split",
            "source-only"
          ]
        },
        "until": {
          "$ref": "#/$defs/videoTime"
        },
        "direction": {
          "type": "string"
        },
        "simulation": {
          "$ref": "#/$defs/simulation"
        },
        "camera": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cameraKey"
          }
        },
        "hiddenLayers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "highlight": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/highlight"
          }
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pictureCue"
          }
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "fadeIn": {
          "$ref": "#/$defs/fade"
        },
        "fadeOut": {
          "$ref": "#/$defs/fade"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "until",
        "simulation",
        "camera",
        "hiddenLayers",
        "overlays",
        "evidence"
      ]
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "narration": {
          "type": "string",
          "pattern": "\\S"
        },
        "speechOffset": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "type": "string"
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shot"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "narration",
        "shots"
      ]
    }
  }
}
