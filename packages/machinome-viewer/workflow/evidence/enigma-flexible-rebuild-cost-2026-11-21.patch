+// PROTOTYPE (scratch, 21 November 2026): the box in one pass over the
+// position array and the sphere in a second, written where three.js's
+// `computeBoundingBox` and `computeBoundingSphere` write, in place of
+// their three passes through the attribute's accessors.
+function tightBounds(geometry: THREE.BufferGeometry, a: Float32Array): void {
+  let minX = +Infinity, minY = +Infinity, minZ = +Infinity;
+  let maxX = -Infinity, maxY = -Infinity, maxZ = -Infinity;
+  const n = a.length;
+  for (let i = 0; i < n; i += 3) {
+    const x = a[i], y = a[i + 1], z = a[i + 2];
+    minX = Math.min(minX, x); minY = Math.min(minY, y); minZ = Math.min(minZ, z);
+    maxX = Math.max(maxX, x); maxY = Math.max(maxY, y); maxZ = Math.max(maxZ, z);
+  }
+  if (geometry.boundingBox === null) geometry.boundingBox = new THREE.Box3();
+  geometry.boundingBox.min.set(minX, minY, minZ);
+  geometry.boundingBox.max.set(maxX, maxY, maxZ);
+  if (geometry.boundingSphere === null) geometry.boundingSphere = new THREE.Sphere();
+  const empty = maxX < minX || maxY < minY || maxZ < minZ;
+  const cx = empty ? 0 : (minX + maxX) * 0.5;
+  const cy = empty ? 0 : (minY + maxY) * 0.5;
+  const cz = empty ? 0 : (minZ + maxZ) * 0.5;
+  let most = 0;
+  for (let i = 0; i < n; i += 3) {
+    const dx = cx - a[i], dy = cy - a[i + 1], dz = cz - a[i + 2];
+    most = Math.max(most, dx * dx + dy * dy + dz * dz);
+  }
+  geometry.boundingSphere.center.set(cx, cy, cz);
+  geometry.boundingSphere.radius = Math.sqrt(most);
+}
