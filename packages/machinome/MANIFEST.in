include AI-USE.md
include CONTRIBUTING.rst
include HISTORY.rst
include LICENSE
recursive-include LICENSES *.txt
include README.rst

recursive-include machinome/manager/templates *
include machinome/vet/universe.toml

recursive-include tests *
recursive-exclude * __pycache__
recursive-exclude * *.py[co]

# The manual, buildable from the archive: its pages and configuration, its
# own extension and table (docs/_ext), its static files, the committed
# exports and the example projects beside the pages (change `manual-extras`).
recursive-include docs *.rst conf.py Makefile make.bat requirements.txt *.jpg *.png *.gif
recursive-include docs/_ext *.py *.toml
recursive-include docs/_static *.css *.js *.svg
recursive-include docs/_exports *.json *.stl
recursive-include docs/howto *.html *.js *.py *.toml
recursive-include docs/tutorial *.py *.svg *.toml
prune docs/_build
