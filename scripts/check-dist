#!/usr/bin/env python3
# Machinome - Source code for machines
# Copyright (C) 2023-2026 Luis Henrique Cassis Fagundes
# SPDX-License-Identifier: GPL-2.0-or-later OR CERN-OHL-S-2.0+

"""Build, check and smoke every distribution of the repository; upload nothing.

For each member of the uv workspace declared in the root `pyproject.toml`,
this script builds the sdist and the wheel (the wheel from the sdist) in a
temporary directory outside the repository, checks both archives with
`twine check --strict`, and checks that the sdist carries every file the
member's directory reaches by a symbolic link as a regular file with the
bytes of the link's target. It then installs every member's wheel into a
throwaway virtual environment outside the repository and smokes each member
there, from a table keyed by distribution name.

It uploads nothing. Installing the wheels' dependencies needs a package
index. It needs `build` and `twine` importable by the interpreter that runs
it, and writes nothing inside the repository but the build's own scratch
(`build/`, `*.egg-info`), which each member's `.gitignore`, or the root's,
ignores.
"""

import glob
import string
import subprocess
import sys
import tarfile
import tempfile
import tomllib
import zipfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]

#: The licence checks of an extension package's smoke, formatted with its
#: distribution name: the core's row states the same lines in its own code.
LICENCES = string.Template('''
distribution = metadata.distribution('$name')
expression = distribution.metadata['License-Expression']
assert expression == 'GPL-2.0-or-later OR CERN-OHL-S-2.0+', expression
print('License-Expression:', expression)
licences = sorted(str(path).split('.dist-info/', 1)[1]
                  for path in distribution.files
                  if '.dist-info/' in str(path) and 'licenses/' in str(path))
for path in licences:
    print('  ', path)
for path in ('licenses/LICENSE', 'licenses/LICENSES/GPL-2.0-or-later.txt',
             'licenses/LICENSES/CERN-OHL-S-2.0.txt'):
    assert path in licences, path
''')

#: The smoke of an engine package: its provider resolved by the core's seam,
#: its file owned by its own distribution inside the venv, its version and
#: pin the core's, one operation on its kernel, its licence.
ENGINE = string.Template('''
import importlib.metadata as metadata
from pathlib import Path
import machinome.engine as seams
provider = seams.$seam()
assert provider is not None, '$name: the seam resolves no provider'
assert provider.__name__ == 'machinome.engine.$engine', provider.__name__
assert provider.CONTRACT == seams.$contract, provider.CONTRACT
distribution = metadata.distribution('$name')
version = metadata.version('machinome')
assert distribution.version == version, (distribution.version, version)
files = [str(path) for path in distribution.files]
assert 'machinome/engine/$engine.py' in files, files
assert not [path for path in files if path.endswith('__init__.py')], files
owned = Path(distribution.locate_file('machinome/engine/$engine.py')).resolve()
assert owned == Path(provider.__file__).resolve(), (owned, provider.__file__)
assert owned.is_relative_to(Path(VENV).resolve()), owned
assert f'machinome~={version}' in distribution.requires, distribution.requires
$operation
''')

#: The one line an engine's smoke prints last.
ENGINE_LINE = '''
print('$name', distribution.version, 'provider', provider.__file__,
      'contract', provider.CONTRACT, 'result', result)
'''


def engine_smoke(name, engine, seam, contract, operation):
    """The code of an engine package's smoke."""
    values = dict(name=name, engine=engine, seam=seam, contract=contract,
                  operation=operation.strip())
    return (ENGINE.substitute(values) + LICENCES.substitute(values)
            + string.Template(ENGINE_LINE).substitute(values))


#: The smoke of a node package: its module imported at its address, its file
#: owned by its own distribution inside the venv, its version and pins the
#: core's, then one part of its node type rendered on its kernel, in a new
#: project directory under the temporary directory, and its volume read
#: through the B-rep engine; its licence.
NODE = string.Template('''
import importlib
import importlib.metadata as metadata
import os
import sys
import tempfile
from pathlib import Path
module = importlib.import_module('machinome.node.$node')
distribution = metadata.distribution('$name')
version = metadata.version('machinome')
assert distribution.version == version, (distribution.version, version)
files = [str(path) for path in distribution.files]
assert 'machinome/node/$node.py' in files, files
assert not [path for path in files if path.endswith('__init__.py')], files
owned = Path(distribution.locate_file('machinome/node/$node.py')).resolve()
assert owned == Path(module.__file__).resolve(), (owned, module.__file__)
assert owned.is_relative_to(Path(VENV).resolve()), owned
for pin in (f'machinome~={version}', f'machinome-engine-brep~={version}'):
    assert pin in distribution.requires, (pin, distribution.requires)
project = tempfile.mkdtemp(prefix='$name-', dir=os.getcwd())
with open(os.path.join(project, 'pyproject.toml'), 'w') as stream:
    stream.write('[tool.machinome]\\n')
with open(os.path.join(project, 'parts.py'), 'w') as stream:
    stream.write($parts)
sys.path.insert(0, project)
os.chdir(project)
from machinome.engine import brep_engine
engine = brep_engine()
$operation
''')

#: The one line a node package's smoke prints last.
NODE_LINE = '''
print('$name', distribution.version, 'module', module.__file__,
      'volume', result)
'''


def node_smoke(name, node, parts, operation):
    """The code of a node package's smoke: `parts` is the source of the
    project's `parts.py`, one class `Part`; `operation` sets `result`."""
    values = dict(name=name, node=node, parts=repr(parts.lstrip()),
                  operation=operation.strip())
    return (NODE.substitute(values) + LICENCES.substitute(values)
            + string.Template(NODE_LINE).substitute(values))


#: The smoke of each member, run with the throwaway venv's `python -I -c`
#: from the temporary directory: the extras its wheel is installed with, and
#: the code that proves it. `VENV` is defined before the code runs. A member
#: without a row fails the script. A row with `through` is installed by that
#: extra of the core, from the built archives, never by its own wheel's path.
SMOKES = {
    'machinome': {
        'extras': ['openscad', 'stl'],
        'code': '''
import importlib.metadata as metadata
from pathlib import Path
import machinome
assert Path(machinome.__file__).resolve().is_relative_to(Path(VENV).resolve()), \\
    machinome.__file__
print('machinome', machinome.__version__, 'from', machinome.__file__)
import machinome.node.openscad
import machinome.node.stl
distribution = metadata.distribution('machinome')
expression = distribution.metadata['License-Expression']
assert expression == 'GPL-2.0-or-later OR CERN-OHL-S-2.0+', expression
print('License-Expression:', expression)
licences = sorted(str(path).split('.dist-info/', 1)[1]
                  for path in distribution.files
                  if '.dist-info/' in str(path) and 'licenses/' in str(path))
for path in licences:
    print('  ', path)
for path in ('licenses/LICENSE', 'licenses/LICENSES/GPL-2.0-or-later.txt',
             'licenses/LICENSES/CERN-OHL-S-2.0.txt'):
    assert path in licences, path
''',
        'commands': [['machinome', '--help']],
    },
    'machinome-engine-brep': {
        'through': 'brep',
        'extras': [],
        'code': engine_smoke(
            'machinome-engine-brep', 'brep', 'brep_engine', 'BREP_CONTRACT',
            '''
from OCP.BRepPrimAPI import BRepPrimAPI_MakeBox
from OCP.gp import gp_Pnt
result = provider.solid_volume(
    BRepPrimAPI_MakeBox(gp_Pnt(0, 0, 0), 10, 10, 10).Shape())
assert abs(result - 1000) < 1e-6, result
'''),
        'commands': [],
    },
    'machinome-engine-mesh': {
        'through': 'mesh',
        'extras': [],
        'code': engine_smoke(
            'machinome-engine-mesh', 'mesh', 'mesh_engine', 'MESH_CONTRACT',
            '''
result = provider.volume(provider.centred_box([2.0, 3.0, 4.0]))
assert result == 24.0, result
assert provider.identity()[0] == 'manifold3d', provider.identity()
'''),
        'commands': [],
    },
    'machinome-node-cadquery': {
        'through': 'cadquery',
        'extras': [],
        'code': node_smoke(
            'machinome-node-cadquery', 'cadquery',
            '''
import cadquery as cq
from machinome.node.cadquery import CadQueryNode


class Part(CadQueryNode):
    def render(self):
        return cq.Workplane().box(10, 10, 10)
''',
            '''
import parts
node = parts.Part()
node.assemble()
result = engine.solid_volume(node.shape())
assert abs(result - 1000) < 1e-6, result
'''),
        'commands': [],
    },
    'machinome-node-build123d': {
        'through': 'build123d',
        'extras': [],
        'code': node_smoke(
            'machinome-node-build123d', 'build123d',
            '''
import build123d as b3d
from machinome.node.build123d import Build123dNode


class Part(Build123dNode):
    def render(self):
        return b3d.Box(2, 3, 4)
''',
            '''
import parts
node = parts.Part()
node.assemble()
result = engine.solid_volume(node.shape())
assert abs(result - 24) < 1e-6, result
'''),
        'commands': [],
    },
    'machinome-node-step': {
        'through': 'step',
        'extras': [],
        'code': node_smoke(
            'machinome-node-step', 'step',
            '''
from machinome.node.step import StepNode


class Part(StepNode):
    step_source = 'box.step'
''',
            '''
import cadquery as cq
cq.exporters.export(cq.Workplane().box(4, 5, 6), 'box.step')
import parts
node = parts.Part()
node.assemble()
result = engine.solid_volume(node.shape())
assert abs(result - 120) < 1e-6, result
'''),
        'commands': [],
    },
    'machinome-node-molejo': {
        'through': 'molejo',
        'extras': [],
        'code': node_smoke(
            'machinome-node-molejo', 'molejo',
            '''
from molejo import Circle, Helix, P, Shape
from machinome.motion.ports import TranslationalPort
from machinome.node.molejo import MolejoNode


class Part(MolejoNode):
    height = TranslationalPort(unit='mm')

    def render(self):
        return Shape(profile=Circle(radius=1.0),
                     path=[Helix(radius=8.0, turns=3, height=P.height)],
                     path_samples=120, profile_samples=12)
''',
            '''
import math
import parts
node = parts.Part()
solid, _ = node.snapshot_shape(node.render(), {'height': 20.0})
assert engine.solid_count(solid) == 1, engine.solid_count(solid)
result = engine.solid_volume(solid)
expected = math.pi * 3 * math.sqrt((16 * math.pi) ** 2 + (20 / 3) ** 2)
assert abs(result - expected) < 1e-3 * expected, (result, expected)
'''),
        'commands': [],
    },
}


class Failure(Exception):
    """A check that failed, with what failed."""


def run(command, cwd, quiet=False):
    # A smoke's code is shown by its first line.
    printed = ' '.join(str(part).strip().split('\n')[0]
                       + (' ...' if '\n' in str(part).strip() else '')
                       for part in command)
    print(f'$ {printed}', flush=True)
    result = subprocess.run([str(part) for part in command], cwd=cwd,
                            stdout=subprocess.PIPE if quiet else None,
                            stderr=subprocess.STDOUT if quiet else None,
                            text=True)
    if result.returncode != 0:
        if quiet:
            print(result.stdout)
        raise Failure(f'exit {result.returncode}: {printed}')
    return result


def members():
    """(directory, distribution name) of every workspace member, sorted."""
    workspace = tomllib.loads((ROOT / 'pyproject.toml').read_text())
    patterns = workspace['tool']['uv']['workspace']['members']
    found = set()
    for pattern in patterns:
        for match in glob.glob(str(ROOT / pattern)):
            directory = Path(match)
            if (directory / 'pyproject.toml').is_file():
                found.add(directory)
    listed = []
    for directory in sorted(found):
        project = tomllib.loads((directory / 'pyproject.toml').read_text())
        listed.append((directory, project['project']['name']))
    if not listed:
        raise Failure(f'no workspace member under {ROOT}')
    return listed


def linked_files(directory):
    """(path in the archive, bytes) of every file the member reaches by a
    symbolic link, each file below a linked directory included."""
    files = []
    for entry in sorted(directory.iterdir()):
        if not entry.is_symlink():
            continue
        target = entry.resolve()
        if target.is_dir():
            for path in sorted(target.rglob('*')):
                if path.is_file():
                    name = f'{entry.name}/{path.relative_to(target).as_posix()}'
                    files.append((name, path.read_bytes()))
        else:
            files.append((entry.name, target.read_bytes()))
    return files


def check_sdist(sdist, directory):
    """The sdist holds each linked file as a regular file of the same bytes."""
    with tarfile.open(sdist) as archive:
        names = archive.getnames()
        top = names[0].split('/', 1)[0]
        for name, expected in linked_files(directory):
            member = f'{top}/{name}'
            try:
                info = archive.getmember(member)
            except KeyError:
                raise Failure(f'{sdist.name} lacks {member}') from None
            if not info.isfile():
                raise Failure(f'{sdist.name} holds {member} as a link, '
                              'not a regular file')
            found = archive.extractfile(info).read()
            if found != expected:
                raise Failure(f'{sdist.name}: {member} differs from the '
                              f'root\'s ({len(found)} bytes, expected '
                              f'{len(expected)})')
            print(f'   {member}: regular file, {len(found)} bytes, equal '
                  'to the root\'s')
        print(f'   {sdist.name}: {len(names)} entries')


def build(directory, name, scratch):
    """Build, check and return the wheel of one member."""
    out = scratch / 'dist' / name
    run([sys.executable, '-m', 'build', directory, '--outdir', out], ROOT,
        quiet=True)
    sdists = sorted(out.glob('*.tar.gz'))
    wheels = sorted(out.glob('*.whl'))
    if len(sdists) != 1 or len(wheels) != 1:
        raise Failure(f'{name}: built {sorted(p.name for p in out.iterdir())}')
    run([sys.executable, '-m', 'twine', 'check', '--strict',
         sdists[0], wheels[0]], ROOT)
    check_sdist(sdists[0], directory)
    with zipfile.ZipFile(wheels[0]) as wheel:
        print(f'   {wheels[0].name}: {len(wheel.namelist())} entries')
    return wheels[0]


def main():
    with tempfile.TemporaryDirectory(prefix='machinome-check-dist-') as tmp:
        scratch = Path(tmp).resolve()
        if scratch.is_relative_to(ROOT):
            raise Failure(f'the temporary directory {scratch} lies inside '
                          f'the repository {ROOT}')
        listed = members()
        for directory, name in listed:
            if name not in SMOKES:
                raise Failure(f'{name} has no smoke in scripts/check-dist')
        print('Members:', ', '.join(name for _, name in listed))
        wheels = {name: build(directory, name, scratch)
                  for directory, name in listed}

        venv = scratch / 'venv'
        run([sys.executable, '-m', 'venv', venv], scratch)
        python = venv / 'bin' / 'python'
        links = []
        for name in wheels:
            links += ['--find-links', scratch / 'dist' / name]
        requirements = []
        for name, wheel in wheels.items():
            extras = SMOKES[name]['extras']
            through = SMOKES[name].get('through')
            if through:
                requirements.append(f'machinome[{through}]')
            else:
                requirements.append(
                    f'{wheel}[{",".join(extras)}]' if extras else str(wheel))
        run([python, '-m', 'pip', 'install', '--quiet', *links,
             *requirements], scratch)

        for name in wheels:
            smoke = SMOKES[name]
            prefix = f'VENV = {str(venv)!r}\n'
            run([python, '-I', '-c', prefix + smoke['code']], scratch)
            for command in smoke['commands']:
                run([venv / 'bin' / command[0], *command[1:]], scratch,
                    quiet=True)
                print(f'   {" ".join(command)}: exit 0')
    print('Every distribution built, checked, installed and smoked; '
          'nothing uploaded.')


if __name__ == '__main__':
    try:
        main()
    except Failure as failure:
        print(f'check-dist failed: {failure}', file=sys.stderr)
        print('Nothing uploaded.', file=sys.stderr)
        sys.exit(1)
