"""Build, check and smoke every distribution of the repository; upload nothing.

For each member of the uv workspace declared in the root `pyproject.toml`,
this script builds the sdist and the wheel (the wheel from the sdist) in a
temporary directory outside the repository, checks both archives with
`twine check --strict`, and checks that the sdist carries every file the
member's directory reaches by a symbolic link as a regular file with the
bytes of the link's target. It then installs every member's wheel into a
throwaway virtual environment outside the repository and smokes each member
there, from a table keyed by distribution name.

It uploads nothing. Installing the wheels' dependencies needs a package
index. It needs `build` and `twine` importable by the interpreter that runs
it, and writes nothing inside the repository but the build's own scratch
(`build/`, `*.egg-info`), which each member's `.gitignore`, or the root's,
ignores.
"""

import glob
import string
import subprocess
import sys
import tarfile
import tempfile
import tomllib
import zipfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]

#: The mechanics helpers' own version (change `join-mechanics`): they are
#: not numbered with the set.
MECHANICS_VERSION = tomllib.loads(
    (ROOT / 'packages/machinome-mechanics/pyproject.toml').read_text()
)['project']['version']

#: The licence checks of an extension package's smoke, formatted with its
#: distribution name: the core's row states the same lines in its own code.
LICENCES = string.Template('''
distribution = metadata.distribution('$name')
expression = distribution.metadata['License-Expression']
assert expression == 'GPL-2.0-or-later OR CERN-OHL-S-2.0+', expression
print('License-Expression:', expression)
licences = sorted(str(path).split('.dist-info/', 1)[1]
                  for path in distribution.files
                  if '.dist-info/' in str(path) and 'licenses/' in str(path))
for path in licences:
    print('  ', path)
for path in ('licenses/LICENSE', 'licenses/LICENSES/GPL-2.0-or-later.txt',
             'licenses/LICENSES/CERN-OHL-S-2.0.txt'):
    assert path in licences, path
''')

#: The smoke of an engine package: its provider resolved by the core's seam,
#: its file owned by its own distribution inside the venv, its version and
#: pin the core's, one operation on its kernel, its licence.
ENGINE = string.Template('''
import importlib.metadata as metadata
from pathlib import Path
import machinome.engine as seams
provider = seams.$seam()
assert provider is not None, '$name: the seam resolves no provider'
assert provider.__name__ == 'machinome.engine.$engine', provider.__name__
assert provider.CONTRACT == seams.$contract, provider.CONTRACT
distribution = metadata.distribution('$name')
version = metadata.version('machinome')
assert distribution.version == version, (distribution.version, version)
files = [str(path) for path in distribution.files]
assert 'machinome/engine/$engine.py' in files, files
assert not [path for path in files if path.endswith('__init__.py')], files
owned = Path(distribution.locate_file('machinome/engine/$engine.py')).resolve()
assert owned == Path(provider.__file__).resolve(), (owned, provider.__file__)
assert owned.is_relative_to(Path(VENV).resolve()), owned
assert f'machinome~={version}' in distribution.requires, distribution.requires
$operation
''')

#: The one line an engine's smoke prints last.
ENGINE_LINE = '''
print('$name', distribution.version, 'provider', provider.__file__,
      'contract', provider.CONTRACT, 'result', result)
'''


def engine_smoke(name, engine, seam, contract, operation):
    """The code of an engine package's smoke."""
    values = dict(name=name, engine=engine, seam=seam, contract=contract,
                  operation=operation.strip())
    return (ENGINE.substitute(values) + LICENCES.substitute(values)
            + string.Template(ENGINE_LINE).substitute(values))


#: The smoke of a node package: its module imported at its address, its file
#: owned by its own distribution inside the venv, its version and pins the
#: core's, then one part of its node type rendered on its kernel, in a new
#: project directory under the temporary directory, and its volume read
#: through the B-rep engine; its licence.
NODE = string.Template('''
import importlib
import importlib.metadata as metadata
import os
import sys
import tempfile
from pathlib import Path
module = importlib.import_module('machinome.node.$node')
distribution = metadata.distribution('$name')
version = metadata.version('machinome')
assert distribution.version == version, (distribution.version, version)
files = [str(path) for path in distribution.files]
assert 'machinome/node/$node.py' in files, files
assert not [path for path in files if path.endswith('__init__.py')], files
owned = Path(distribution.locate_file('machinome/node/$node.py')).resolve()
assert owned == Path(module.__file__).resolve(), (owned, module.__file__)
assert owned.is_relative_to(Path(VENV).resolve()), owned
for pin in (f'machinome~={version}', f'machinome-engine-brep~={version}'):
    assert pin in distribution.requires, (pin, distribution.requires)
project = tempfile.mkdtemp(prefix='$name-', dir=os.getcwd())
with open(os.path.join(project, 'pyproject.toml'), 'w') as stream:
    stream.write('[tool.machinome]\\n')
with open(os.path.join(project, 'parts.py'), 'w') as stream:
    stream.write($parts)
sys.path.insert(0, project)
os.chdir(project)
from machinome.engine import brep_engine
engine = brep_engine()
$operation
''')

#: The one line a node package's smoke prints last.
NODE_LINE = '''
print('$name', distribution.version, 'module', module.__file__,
      'volume', result)
'''


def node_smoke(name, node, parts, operation):
    """The code of a node package's smoke: `parts` is the source of the
    project's `parts.py`, one class `Part`; `operation` sets `result`."""
    values = dict(name=name, node=node, parts=repr(parts.lstrip()),
                  operation=operation.strip())
    return (NODE.substitute(values) + LICENCES.substitute(values)
            + string.Template(NODE_LINE).substitute(values))


#: The smoke of a node package over no B-rep engine: its module imported at
#: its address, the files it ships under `machinome/` owned by its own
#: distribution inside the venv, its version and pins the core's, then one
#: part of its node type in a new project directory under the temporary
#: directory, rendered to its STL where the part's external program is on
#: the PATH, whose volume trimesh reads, and otherwise built as far as the
#: program allows; its licence.
MESH_NODE = string.Template('''
import importlib
import importlib.metadata as metadata
import os
import shutil
import sys
import tempfile
from pathlib import Path
import trimesh
from machinome.node.base import StlRenderStart
module = importlib.import_module('machinome.node.$node')
distribution = metadata.distribution('$name')
version = metadata.version('machinome')
assert distribution.version == version, (distribution.version, version)
files = [str(path) for path in distribution.files]
shipped = sorted(path for path in files
                 if path.startswith('machinome/') and path.endswith('.py'))
assert shipped == $shipped, shipped
owned = Path(distribution.locate_file(shipped[0])).resolve()
assert owned == Path(module.__file__).resolve(), (owned, module.__file__)
assert owned.is_relative_to(Path(VENV).resolve()), owned
for pin in $pins:
    assert pin.format(version=version) in distribution.requires, (
        pin, distribution.requires)
project = tempfile.mkdtemp(prefix='$name-', dir=os.getcwd())
with open(os.path.join(project, 'pyproject.toml'), 'w') as stream:
    stream.write('[tool.machinome]\\n')
with open(os.path.join(project, 'parts.py'), 'w') as stream:
    stream.write($parts)
sys.path.insert(0, project)
os.chdir(project)


def stl_volume(node):
    """Render `node`'s STL, waiting on its renderer, and read its volume."""
    while True:
        try:
            node.trigger_stl()
            break
        except StlRenderStart as job:
            job.wait()
    return trimesh.load(node.stl_file).volume


$operation
''')

#: The one line such a smoke prints last.
MESH_NODE_LINE = '''
print('$name', distribution.version, 'module', module.__file__, result)
'''


def mesh_node_smoke(name, node, shipped, pins, parts, operation):
    """The code of a node package's smoke whose files `shipped` lists:
    `shipped` the files it ships under `machinome/`, `pins` its requirements
    on the set (`{version}` standing for the version), `parts` the source of
    the project's `parts.py`, one class `Part`; `operation` sets `result`."""
    values = dict(name=name, node=node, shipped=repr(sorted(shipped)),
                  pins=repr(pins), parts=repr(parts.lstrip()),
                  operation=operation.strip())
    return (MESH_NODE.substitute(values) + LICENCES.substitute(values)
            + string.Template(MESH_NODE_LINE).substitute(values))


#: The smoke of each member, run with the throwaway venv's `python -I -c`
#: from the temporary directory: the extras its wheel is installed with, and
#: the code that proves it. `VENV` is defined before the code runs. A member
#: without a row fails the script. A row with `through` is installed by that
#: extra of the core, from the built archives, never by its own wheel's path.
SMOKES = {
    'machinome': {
        'extras': ['openscad', 'stl'],
