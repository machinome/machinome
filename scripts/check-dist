expression = distribution.metadata['License-Expression']
assert expression == 'GPL-2.0-or-later OR CERN-OHL-S-2.0+', expression
print('License-Expression:', expression)
licences = sorted(str(path).split('.dist-info/', 1)[1]
                  for path in distribution.files
                  if '.dist-info/' in str(path) and 'licenses/' in str(path))
for path in licences:
    print('  ', path)
for path in ('licenses/LICENSE', 'licenses/LICENSES/GPL-2.0-or-later.txt',
             'licenses/LICENSES/CERN-OHL-S-2.0.txt'):
    assert path in licences, path
''',
        'commands': [['machinome', '--help']],
    },
    'machinome-engine-brep': {
        'through': 'brep',
