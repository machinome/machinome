# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
# The vet fixture projects keep a `parts` package on purpose; the rule
# above hid them from the 0.7.0 vet cycle's commit and CI ran red.
!tests/vet_projects/*/sim/parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# virtualenv
.venv
venv/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# IDE settings
.vscode/
.idea/

# the suite's build directories: tests/_build, tests/_build_meta and the
# tests/_build_<name> a test preserves. Ignored here, not only in a
# developer's .git/info/exclude, or an export taken while a test build
# exists records the checkout as dirty.
tests/_build/
tests/_build_*/

# project build locks left beside a test build directory. The framework
# records this exclusion itself for a user's project, but only where `.git`
# is a real directory -- never in a worktree, which is where this repo's
# own suite runs.
tests/_build*.lock

# mesh fixtures for the STL leaf, generated by tests/test_stl_node.py from
# CadQuery parts rather than committed: the round trip IS the fixture, and
# the framework repository carries no binary meshes.
tests/stl_project/*.stl

# STEP fixtures for the STEP leaf, generated by tests/test_step_node.py from
# CadQuery assemblies rather than committed: the round trip IS the fixture,
# and the framework repository carries no vendor STEP file.
tests/step_project/*.step

# dev-env worktrees (scripts/dev-env)
WTs/
